* {
    background-color: transparent;
    text-color: #11111b;
    margin: 0;
    padding: 0;
}
window {
    background-color: #eff1f5cc;
    border-radius: 8px;
    width: 32em;
}
inputbar {
    children: [ entry];
    background-color: #ccd0dacc;
}
entry {
    placeholder: " ";
    placeholder-color: #9ca0b0;
    padding: 0.75em 1.25em;
}
listview {
    lines: 6;
    margin: 0.5em 0 0.75em;
}
element {
    padding: 0.5em;
    margin: 0 0.75em;
}
element.selected {
    background-color: #7287fd;
    border-radius: 8px;
}
element-text {
    highlight: bold;
    padding: 0.25em;
    font: "Open Sans 14px";
}
element-text.selected {
    color: #eff1f5;
}
element-icon {
    size: 1.5em;
}
